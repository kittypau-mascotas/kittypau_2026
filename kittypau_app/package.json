{
  "name": "kittypau_app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:web": "next dev",
    "dev:mobile": "npx cap run android",
    "build": "next build",
    "start": "next start",
    "android:add": "npx cap add android",
    "android:assets": "npx @capacitor/assets generate --android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:build:debug": "cd android && .\\gradlew assembleDebug",
    "test": "vitest run",
    "lint": "eslint",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "clean:imports": "eslint . --fix --rule \"unused-imports/no-unused-imports:error\"",
    "type-check": "tsc --noEmit",
    "encoding-check": "python ../scripts/check_encoding.py kittypau_app/src kittypau_app/README.md kittypau_app/package.json kittypau_app/tsconfig.json kittypau_app/next.config.ts kittypau_app/eslint.config.mjs kittypau_app/capacitor.config.ts kittypau_app/postcss.config.mjs Docs",
    "build-check": "next build",
    "security-check": "npm audit --audit-level=high",
    "fix:all": "npm run lint:fix && npm run clean:imports && npm run format",
    "dev:check": "npm run fix:all && npm run type-check && npm run encoding-check",
    "ci:check": "npm run dev:check && npm run test && npm run build-check",
    "staged:check": "npm run encoding-check && lint-staged --no-stash"
  },
  "dependencies": {
    "@capacitor/local-notifications": "^8.0.2",
    "@supabase/supabase-js": "^2.106.1",
    "chart.js": "^4.5.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.542.0",
    "mqtt": "^5.10.4",
    "next": "^16.2.12",
    "react": "^19.2.3",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.3",
    "react-scroll-parallax": "^3.5.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.0",
    "@capacitor/core": "^8.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-sonarjs": "^4.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "prettier": "^3.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
