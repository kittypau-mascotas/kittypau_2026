# Public values (these can be present in browser/APK)
NEXT_PUBLIC_SITE_URL="https://kittypau-app.vercel.app"
NEXT_PUBLIC_APP_FLAVOR="web"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_xxx"
CAPACITOR_SERVER_URL="https://app.kittypau-app.vercel.app"
# Kill-switch de push notifications (FCM) -- default apagado a propósito.
# NEXT_PUBLIC_PUSH_NOTIFICATIONS_ENABLED != "true" hace que
# usePushTokenRegistration.ts nunca llame a PushNotifications.register().
# Prenderlo sin que exista google-services.json real en el APK CRASHEA la
# app (IllegalStateException: Default FirebaseApp is not initialized --
# confirmado en dispositivo real 2026-09-09). Recién poner "true" cuando
# el APK se recompile con Firebase configurado, ver
# Knowledge/29_Specs/008-push-notifications-fcm/plan.md.
NEXT_PUBLIC_PUSH_NOTIFICATIONS_ENABLED="false"

# MQTT WebSocket — read-only, seguro para el browser
# Crear usuario read-only en HiveMQ Dashboard con ACL: +/SENSORS (subscribe only)
NEXT_PUBLIC_MQTT_BROKER="YOUR_HIVEMQ_HOST.hivemq.cloud"
NEXT_PUBLIC_MQTT_PORT_WS="8884"
NEXT_PUBLIC_MQTT_USER_READONLY="replace_me"
NEXT_PUBLIC_MQTT_PASS_READONLY="replace_me"

# Demo /today en vivo (Knowledge/29_Specs/009-demo-today-en-vivo) -- códigos KPCL
# del dispositivo cuya data real espeja la demo pública. Reconfigurable sin tocar
# código: cambiar el valor y redeploy. Defaults en src/lib/demo/demo-config.ts.
DEMO_FOOD_DEVICE_CODE="KPCL0034"
DEMO_WATER_DEVICE_CODE="KPCL0035"

# Server-only values (never put these in mobile client code)
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_xxx"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxx"
MQTT_WEBHOOK_SECRET="replace_me"
BRIDGE_HEARTBEAT_SECRET="replace_me"
CRON_SECRET="replace_me"
# Push notifications reales (FCM) -- ver Knowledge/29_Specs/008-push-notifications-fcm/plan.md.
# JSON completo de la cuenta de servicio de Firebase, como string de una línea
# (Firebase Console > Configuración del proyecto > Cuentas de servicio > Generar
# nueva clave privada). NUNCA commitear el archivo real, solo esta variable.
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...", ...}'
UPSTASH_REDIS_REST_URL="https://YOUR_UPSTASH.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace_me"
VERCEL_API_TOKEN="replace_me"
HF_TOKEN="hf_xxx"
HF_MODEL="meta-llama/Llama-3.1-8B-Instruct"

# Analytics DB — optional/legacy server-only (leave empty if you do not use the
# historical analytics database)
SUPABASE_ANALYTICS_URL="https://YOUR_ANALYTICS_PROJECT.supabase.co"
SUPABASE_ANALYTICS_SERVICE_KEY="sb_secret_analytics_xxx"
